bin/
*.db
bench/seed-store/
# Anchor build artifacts to the repo root: an unanchored `beacon` also
# matched docs/beacon/, which made frozen truth packages uncommittable
# (and therefore never a consumable baseline).
/beacon
/beacon-desktop

# local agent state (not shipped)
.omc/
.workbuddy-ai/
logs/

# runtime state (not shipped)
.beacon/artifacts/
.beacon/state/
.beacon/autotest/

# generated by beacon truth tooling
docs/beacon/*/.machine/
.beacon/evidence-manifest.json
