      "checks": [
        {
          "kind": "contains",
          "text": "parks at"
        },
        {
          "kind": "contains",
          "text": "reason code"
        }
      ]
    },
    {
      "id": "goal-02-contract",
      "prompt": "干完了吗？",
      "expectations": [
        "Emits mode_id, evidence_refs, next and plain_summary",
        "Has at least three worked examples"
      ],
      "checks": [
        {
          "kind": "contains",
          "text": "evidence_refs"
        },
        {
          "kind": "contains",
          "text": "plain_summary"
        },
        {
          "kind": "min_examples",
          "min": 3
        }
      ]
    }
  ]
}
