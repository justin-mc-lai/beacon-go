{
  "schema": "skill-evals.v1",
  "skill": "beacon-goal",
  "cases": [
    {
      "id": "goal-00-boundary",
      "prompt": "帮我把这个需求从头跑到发布，不用问我。",
      "expectations": [
        "Selects mode_id loop-goal",
        "Does not write product code",
        "Refuses to self-release"
      ],
      "checks": [
        {
          "kind": "contains",
          "text": "## HARD GATE"
        },
        {
          "kind": "contains",
          "text": "never write product code"
        },
        {
          "kind": "references_contains",
          "text": "release gate"
        }
      ]
    },
    {
      "id": "goal-01-no-executor",
      "prompt": "接着跑，别停。",
      "expectations": [
        "Reports blocked with a reason code instead of inventing progress",
        "Names the next step (register an executor or advance manually)"
